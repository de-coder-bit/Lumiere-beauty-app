// Import required packages
const express = require("express");
const cors = require("cors");
const dotenv = require("dotenv");

// Load environment variables
dotenv.config();

// Import routes
const salonRoutes = require("./routes/salons");
const bookingRoutes = require("./routes/bookings");
const userRoutes = require("./routes/users");
const authRoutes = require("./routes/auth"); // ➕ YEH LINE ADD KARO

// Initialize express app
const app = express();
const PORT = process.env.PORT || 5000;

// Middleware
app.use(cors());
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// Routes
app.use("/api/salons", salonRoutes);
app.use("/api/bookings", bookingRoutes);
app.use("/api/users", userRoutes);
app.use("/api/auth", authRoutes); // ➕ YEH LINE ADD KARO

// Health check endpoint
app.get("/api/health", (req, res) => {
  res.json({
    status: "ok",
    timestamp: new Date().toISOString(),
    uptime: process.uptime(),
    environment: process.env.NODE_ENV || "development",
  });
});

// Root endpoint
app.get("/", (req, res) => {
  res.json({
    message: "Lumiere App API is running",
    version: "1.0.0",
    endpoints: {
      health: "/api/health",
      salons: "/api/salons",
      bookings: "/api/bookings",
      users: "/api/users",
      auth: "/api/auth/login & /api/auth/signup", // ➕ YEH BHI ADD KAR SAKTE HO (optional)
    },
  });
});

// 404 handler
app.use((req, res) => {
  res.status(404).json({
    success: false,
    message: `Route not found: ${req.method} ${req.url}`,
  });
});

// Error handler
app.use((err, req, res, next) => {
  console.error("Error:", err.message);
  res.status(500).json({
    success: false,
    message: "Internal server error",
    error: err.message,
  });
});

// Start server
app.listen(PORT, () => {
  console.log(`✅ Server running on port ${PORT}`);
  console.log(`⚠ API: http://localhost:${PORT}/api`);
  console.log(`✔ Health: http://localhost:${PORT}/api/health`);
  console.log(`✅ Environment: ${process.env.NODE_ENV || "development"}`);
});
// Import routes (already hai)
const salonRoutes = require("./routes/salons");
const bookingRoutes = require("./routes/bookings"); // ➕ YEH LINE
const userRoutes = require("./routes/users");
const authRoutes = require("./routes/auth");

// Routes (already hai)
app.use("/api/salons", salonRoutes);
app.use("/api/bookings", bookingRoutes); // ➕ YEH LINE
